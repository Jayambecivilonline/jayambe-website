  .hint span { display: inline-block; animation: bob 1.6s ease-in-out infinite; }
  @keyframes bob { 50% { transform: translateY(6px); } }
  .x { padding-left: 20px; } .x li { margin: 6px 0; }
  .stats, .dpr-row { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; margin-top: 18px; }
  .dpr-row { grid-template-columns: repeat(4, 1fr); }
  .stats div, .dpr-row div { background: rgba(255,255,255,.06); border-radius: 6px; padding: 12px 8px; text-align: center; }
  .stats b, .dpr-row b { display: block; font-family: var(--head); font-size: 34px; color: var(--orange-light); line-height: 1; }
  .stats span, .dpr-row span { font-size: 12px; }
  .dpr { margin-top: 18px; border-top: 1px solid rgba(255,255,255,.15); padding-top: 14px; }
