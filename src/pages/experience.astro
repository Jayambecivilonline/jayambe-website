  @keyframes rise { 0% { transform: translate(0, 0) scale(.5); opacity: 0; } 15% { opacity: .38; } 100% { transform: translate(60px, -200px) scale(2.6); opacity: 0; } }
  .puff { transform-box: fill-box; transform-origin: center; }

  .chapters { position: relative; z-index: 2; margin-top: -100vh; }
  .ch { min-height: 130vh; display: flex; align-items: center; padding: 0 max(24px, 6vw); }
