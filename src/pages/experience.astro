  .dec { padding-left: 20px; } .dec li { margin: 8px 0; }
  .slider { display: grid; gap: 8px; margin: 16px 0 8px; font-weight: 600; }
  .slider input { width: 100%; accent-color: var(--accent); height: 30px; }
