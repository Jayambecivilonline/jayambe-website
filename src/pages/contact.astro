---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import SiteVisitForm from '../components/SiteVisitForm.astro';
import { company } from '../data/site';
---
<Base title={`Contact | Free Site Visit & Quote | ${company.short}`} description={`Book a free site visit and quote from Jay Ambe Engineering Works, Nandesari, Vadodara. Call ${company.phone} or WhatsApp us.`}>
  <PageHero eyebrow="Contact us" title="Book your FREE site visit and quote." lead="New plant, expansion or new unit? Tell us about your project. Our engineer visits your site, studies your drawings and scope, and sends you a detailed quote with no cost and no obligation." />

  <section class="section" id="site-visit">
    <div class="wrap grid-c">
      <SiteVisitForm />
      <div class="info">
        <a class="item" href={company.phoneHref}><span>📞</span><div><b>Call us</b>{company.phone}</div></a>
        <a class="item" href={company.whatsapp} target="_blank" rel="noopener"><span>💬</span><div><b>WhatsApp</b>Send photos or drawings directly</div></a>
        <a class="item" href={`mailto:${company.email}`}><span>✉</span><div><b>Email</b>{company.email}</div></a>
        <div class="item"><span>📍</span><div><b>Office</b>{company.address}</div></div>
        <iframe class="map" title="Map of our office" loading="lazy" src="https://www.google.com/maps?q=Nandesari,+Vadodara,+Gujarat&output=embed"></iframe>
      </div>
    </div>
  </section>
</Base>

<script>
  // Pre-select the service when arriving from a "Get a free quote" link.
  const svc = new URLSearchParams(location.search).get('service');
  const sel = document.querySelector<HTMLSelectElement>('select[name="service"]');
  if (svc && sel) sel.value = svc;
</script>

<style>
  .grid-c { display: grid; grid-template-columns: 1.2fr 1fr; gap: 40px; align-items: start; }
  .info { display: grid; gap: 14px; }
  .item { display: flex; gap: 16px; align-items: flex-start; padding: 18px; border: 1px solid var(--line); border-radius: var(--radius); text-decoration: none; color: var(--ink); }
  a.item:hover { border-color: var(--accent); }
  .item span { font-size: 24px; }
  .item b { display: block; font-family: var(--head); font-size: 20px; color: var(--ink); }
  .map { width: 100%; height: 260px; border: 0; border-radius: var(--radius); }
  @media (max-width: 900px) { .grid-c { grid-template-columns: 1fr; } }
</style>
