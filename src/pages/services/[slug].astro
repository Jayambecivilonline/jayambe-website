---
// One SEO page per service, laid out as a compact MCB + 4 phases.
import Base from '../../layouts/Base.astro';
import CtaBand from '../../components/CtaBand.astro';
import FaqList from '../../components/FaqList.astro';
import SiteVisitForm from '../../components/SiteVisitForm.astro';
import { servicePages } from '../../data/servicePages';
import { industryPages, locationPages } from '../../data/seoPages';
import { serviceSeo } from '../../data/serviceSeo';
import { guides } from '../../data/guides';
import { serviceFaqs } from '../../data/serviceFaqs';
import { company, serviceGroups, YEARS, FOUNDED, clients } from '../../data/site';

export function getStaticPaths() {
  return servicePages.map((p) => ({ params: { slug: p.slug }, props: { page: p } }));
}
const { page } = Astro.props;
const all = serviceGroups.flatMap((g) => g.services);
const name = all.find((s) => s.slug === page.slug)?.name ?? page.eyebrow;
const related = all.filter((s) => s.slug !== page.slug).slice(0, 6);
const inds = industryPages.filter((i) => page.industries.includes(i.slug));
const url = new URL(`/services/${page.slug}/`, Astro.site).href;
const seo = serviceSeo[page.slug];
const areas = locationPages.filter((l) => seo?.areas.includes(l.slug));
const relGuides = guides.filter((g) => g.services.includes(page.slug));
// lower-case for use mid-sentence, but keep acronyms in capitals
const lower = name.toLowerCase().replace(/\bpeb\b/g, 'PEB').replace(/\bepc\b/g, 'EPC');
const an = (w: string) => (/^[aeiou]/i.test(w) ? 'an' : 'a');
const areaNames = areas.map((a) => a.name).join(', ');

// Shared, keyword-rich FAQs every service page gets (honest, no invented numbers).
const sharedFaqs = [
  { q: `Do you provide ${lower} near me in Vadodara?`, a: `Yes. We are based in Nandesari, Vadodara, and provide ${lower} across Vadodara district${areaNames ? `, including ${areaNames}` : ''}, and elsewhere in Gujarat.` },
  { q: `How do I get a quote for ${lower}?`, a: 'Book a free site visit using the form on this page, call us or WhatsApp us. Our engineer studies your site and drawings and sends a detailed quote, with no obligation.' },
  { q: `How long does ${an(lower)} ${lower} project take?`, a: 'It depends on the scope and size of the job. We give you a clear schedule with the quote, plan the work before day one, and report progress daily so you always know where it stands.' },
  { q: 'Do you use your own workers or subcontract the job?', a: 'We deploy our own skilled crew of fitters, welders, riggers and civil workers. One of our recent daily reports shows 200 workers on a single site.' },
  { q: 'How will I know the progress of my project?', a: 'You get a daily progress report showing manpower on site, measured work executed and equipment deployed. There is a real sample on our homepage.' },
  { q: 'What is your safety record?', a: 'Zero safety incidents. We work under your plant’s permit-to-work system with trained supervisors.' },
  { q: `Why choose Jay Ambe Engineering Works for ${lower}?`, a: `We have worked in Gujarat since ${FOUNDED}, with 25+ industrial clients, some for decades. You get one responsible team, your own daily report, and a free site visit and quote.` },
];
const allFaqs = [...page.faqs, ...(serviceFaqs[page.slug] ?? []), ...sharedFaqs];

const steps = [
  { t: 'Free site visit', d: `Our engineer visits your site, understands your ${lower} requirement and checks site conditions.` },
  { t: 'Scope, drawings and quote', d: 'We review your drawings and scope and send a clear, detailed quotation, with what is included spelled out.' },
  { t: 'Planning before day one', d: 'Work sequence, schedule, material and manpower are planned before mobilisation, so the job never waits for “one more drawing.”' },
  { t: 'Execution with our own crew', d: 'Our own skilled team does the work, safely and under your permit system where required, with a daily progress report to you every evening.' },
  { t: 'Testing, documents and hand-over', d: 'Work is checked, tested where required and documented, then handed over with records.' },
];

const reasons = [
  { t: `Since ${FOUNDED}`, d: `${YEARS} years of industrial work across Gujarat, from our base in Nandesari, Vadodara.` },
  { t: '25+ industrial clients', d: 'Chemical, pharma, gas and petrochemical companies. Sicgil India has worked with us since 1996.' },
  { t: 'Our own skilled crew', d: 'Not labour hired job by job, so the team stays stable from start to finish.' },
  { t: 'Daily progress report', d: 'Manpower, measured work and equipment, sent to you every day of the job.' },
  { t: 'Zero safety incidents', d: 'Safety-first work practices and trained supervisors.' },
  { t: 'One responsible contract', d: `${name} plus civil, steel, piping, mechanical and fire fighting from one team, if you need them.` },
];

const checklist = [
  `Do they have their own crew for ${lower}, or will they hire labour after you sign?`,
  'Can they show you a real daily progress report from a current job?',
  'Can you call clients who have worked with them for years?',
  'What is their safety record, and do they work under a permit-to-work system?',
  'Does the quote spell out exactly what is included, and what is not?',
  'Will one team handle the trades around this job, or will you manage several contractors?',
];

const schema = [
  { '@type': 'Service', name, serviceType: name, description: page.description, areaServed: 'Gujarat, India', url,
    provider: { '@type': 'GeneralContractor', name: company.name, telephone: company.phone, url: Astro.site?.href } },
  { '@type': 'FAQPage', mainEntity: allFaqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) },
  { '@type': 'HowTo', name: `How we deliver ${lower}`, step: steps.map((s, i) => ({ '@type': 'HowToStep', position: i + 1, name: s.t, text: s.d })) },
  { '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: Astro.site?.href },
    { '@type': 'ListItem', position: 2, name: 'Services', item: new URL('/services/', Astro.site).href },
    { '@type': 'ListItem', position: 3, name, item: url },
  ] },
];
---
<Base title={page.title} description={page.description} schema={schema}>
  <!-- MCB -->
  <section class="hero blueprint dark">
    <div class="wrap">
      <nav class="crumbs" aria-label="Breadcrumb"><a href="/">Home</a> › <a href="/services/">Services</a> › <span>{name}</span></nav>
      <span class="eyebrow">{page.eyebrow} · Vadodara, Gujarat · Since {FOUNDED}</span>
      <h1>{page.headline} <span class="hl">{page.highlight}</span></h1>
      <ul class="hooks">{page.hooks.map((h) => <li>{h}</li>)}</ul>
      <div class="btn-row">
        <a href="#quote" class="btn btn-primary">Get a Free Quote</a>
        <a href={company.whatsapp} class="btn btn-ghost" target="_blank" rel="noopener">💬 WhatsApp Us</a>
      </div>
    </div>
  </section>

  <!-- SEO intro: primary keyword, plain-language summary, links to guides -->
  {seo && (
    <section class="section about">
      <div class="wrap about-grid">
        <div>
          <h2>{name} in Vadodara &amp; across Gujarat</h2>
          {seo.about.map((p) => <p>{p}</p>)}
        </div>
        <div class="card facts">
          <h3>At a glance</h3>
          <ul>
            <li><b>Since {FOUNDED}</b>, based in Nandesari, Vadodara</li>
            <li><b>Our own skilled crew</b> on every site</li>
            <li><b><a href="/daily-progress-report/">Daily progress report</a></b> to every client</li>
            <li><b>0 safety incidents</b></li>
            <li><b>Free site visit &amp; quote</b></li>
          </ul>
          {relGuides.length > 0 && (
            <>
              <h4>Helpful guides</h4>
              {relGuides.map((g) => <a href={`/guides/${g.slug}/`}>{g.h1} →</a>)}
            </>
          )}
        </div>
      </div>
    </section>
  )}

  <!-- Phase 1: the customer's question + trust -->
  <section class="section">
    <div class="wrap">
      <span class="eyebrow">Before you choose a contractor</span>
      <h2 class="q">{page.question}</h2>
      <h3 class="wrong-h">What usually goes wrong</h3>
      <div class="wrong">{page.problems.map((p, i) => <div><span>{i + 1}</span>{p}</div>)}</div>
      <p class="trust">{YEARS} years in Gujarat since {FOUNDED} · 25+ industrial clients, including {clients.join(' and ')} · 0 safety incidents · <a href="/clients/">See our clients →</a></p>
    </div>
  </section>

  <!-- Phase 2: the new way to see it + scope -->
  <section class="section alt">
    <div class="wrap two">
      <div>
        <span class="eyebrow">A new way to look at it</span>
        <h2>{page.insight.title}</h2>
        <p class="lead">{page.insight.text}</p>
      </div>
      <div class="card scope">
        <h3>What we do: {name}</h3>
        <ul>{page.scope.map((s) => <li>{s}</li>)}</ul>
      </div>
    </div>
  </section>

  <!-- Process -->
  <section class="section">
    <div class="wrap">
      <span class="eyebrow">How it works</span>
      <h2>Our {lower} process, step by step</h2>
      <ol class="steps">
        {steps.map((s) => <li><b>{s.t}</b><p>{s.d}</p></li>)}
      </ol>
    </div>
  </section>

  <!-- Why choose us -->
  <section class="section alt">
    <div class="wrap">
      <span class="eyebrow">Why plant owners choose us</span>
      <h2>Why choose Jay Ambe for {lower} in Vadodara &amp; Gujarat</h2>
      <div class="grid g3">
        {reasons.map((r) => <div class="card reason"><h3>{r.t}</h3><p>{r.d}</p></div>)}
      </div>
    </div>
  </section>

  <!-- Checklist + where we work -->
  <section class="section">
    <div class="wrap two">
      <div>
        <span class="eyebrow">Before you hire</span>
        <h2>How to choose a {lower} contractor in Gujarat</h2>
        <p>Price is only one part of the decision. Ask every contractor these six questions before you sign:</p>
        <ol class="check">{checklist.map((c) => <li>{c}</li>)}</ol>
        <p>We are happy to answer every one of them during the free site visit. <a href="/guides/how-to-choose-industrial-contractor/">Read the full contractor checklist →</a></p>
      </div>
      <div>
        <span class="eyebrow">Where we work</span>
        <h2>{name} across Vadodara and Gujarat</h2>
        <p>From our base in Nandesari, Vadodara, we provide {lower} across Vadodara district{areaNames ? `, including ${areaNames}` : ''}. We also take projects elsewhere in Gujarat, including Dahej and Bharuch.</p>
        <p>Over {YEARS} years we have worked for 25+ industrial clients in the region, including {clients.join(' and ')}. Whether your site is a new plot in a GIDC estate or a running plant that can’t stop, we plan the work around it.</p>
      </div>
    </div>
  </section>

  <!-- Phase 3: the choice -->
  <section class="section dark blueprint">
    <div class="wrap">
      <div class="center"><span class="eyebrow">The choice is yours</span><h2>Two ways this job can go</h2></div>
      <div class="compare">
        <div class="col lose"><h3>❌ The lowest bidder</h3><ul>{page.problems.map((p) => <li>{p}</li>)}<li>You chase them for updates</li></ul></div>
        <div class="col win"><h3>✅ Jay Ambe Engineering Works</h3><ul><li>Planned before day one</li><li>Our own skilled team on site</li><li>A daily progress report on your phone</li><li>Tested, documented and handed over</li></ul></div>
      </div>
    </div>
  </section>

  {inds.length > 0 && (
    <section class="section">
      <div class="wrap">
        <h2 class="small-h">Industries we do this for</h2>
        <div class="chips">{inds.map((i) => <a href={`/industries/${i.slug}/`}>{i.name}</a>)}</div>
        {areas.length > 0 && (
          <>
            <h2 class="small-h">{name} near you</h2>
            <div class="chips">{areas.map((l) => <a href={`/locations/${l.slug}/`}>📍 {name} in {l.name}</a>)}</div>
          </>
        )}
        <h2 class="small-h">Related services</h2>
        <div class="chips">{related.map((s) => <a href={`/services/${s.slug}/`}>{s.name}</a>)}</div>
      </div>
    </section>
  )}

  <FaqList faqs={allFaqs} heading={`${name}: frequently asked questions`} open={3} />

  <!-- Phase 4: offer -->
  <section class="section alt" id="quote">
    <div class="wrap two">
      <div>
        <span class="eyebrow">Free, no obligation</span>
        <h2>Get a FREE site visit and quote for {lower}.</h2>
        <p class="lead">Our engineer visits your site, studies your drawings and scope, and sends you a clear, detailed quotation at no cost.</p>
        <div class="btn-row"><a href={company.phoneHref} class="btn btn-outline">📞 {company.phone}</a><a href={company.whatsapp} class="btn btn-primary" target="_blank" rel="noopener">💬 WhatsApp</a></div>
      </div>
      <SiteVisitForm />
    </div>
  </section>
  <script define:vars={{ name }}>
    const sel = document.querySelector('select[name="service"]'); if (sel) sel.value = name;
  </script>

  <CtaBand />
</Base>

<style>
  .hero { padding: 48px 0 64px; }
  .crumbs { font-size: 14px; margin-bottom: 18px; color: var(--navy-soft); }
  .crumbs a { color: var(--navy-soft); }
  h1 { color: #fff; max-width: 900px; }
  .hl { color: var(--orange-light); }
  .hooks { list-style: none; padding: 0; margin: 0 0 28px; display: grid; gap: 10px; max-width: 760px; }
  .hooks li { padding-left: 32px; position: relative; font-size: 18px; color: #E6EEF7; }
  .hooks li::before { content: '✔'; position: absolute; left: 0; top: 2px; width: 22px; height: 22px; background: var(--accent); color: var(--navy); border-radius: 50%; font-size: 13px; display: grid; place-items: center; font-weight: 700; }
  .q { max-width: 820px; }
  .wrong-h { margin: 24px 0 12px; }
  .wrong { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px; }
  .wrong div { background: var(--tint); border-radius: var(--radius); padding: 18px; font-weight: 500; }
  .wrong span { display: grid; place-items: center; width: 30px; height: 30px; border-radius: 50%; border: 2px solid var(--navy); color: var(--navy); font-weight: 700; margin-bottom: 10px; }
  .trust { margin: 28px 0 0; font-weight: 500; }
  .two { display: grid; grid-template-columns: 1fr 1fr; gap: 48px; align-items: start; }
  .scope { border-top: 4px solid var(--accent); }
  .scope ul { margin: 0; padding-left: 20px; } .scope li { margin: 6px 0; }
  .compare { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-top: 32px; }
  .col { border-radius: var(--radius); padding: 28px; }
  .col ul { list-style: none; padding: 0; margin: 0; } .col li { padding: 10px 0; }
  .lose { background: rgba(255,255,255,.07); border: 1px dashed rgba(255,255,255,.35); color: var(--navy-soft); }
  .lose li { border-bottom: 1px solid rgba(255,255,255,.12); }
  .win { background: #fff; color: var(--ink); }
  .win h3 { color: var(--orange) !important; }
  .win li { border-bottom: 1px solid var(--line); }
  .small-h { font-size: 26px; margin-top: 8px; }
  .steps { list-style: none; counter-reset: s; padding: 0; margin: 28px 0 0; display: grid; grid-template-columns: repeat(5, 1fr); gap: 16px; }
  .steps li { counter-increment: s; background: var(--tint); border-radius: var(--radius); padding: 20px; position: relative; }
  .steps li::before { content: counter(s); display: grid; place-items: center; width: 38px; height: 38px; border-radius: 50%; background: var(--accent); color: var(--navy); font-family: var(--head); font-weight: 700; font-size: 20px; margin-bottom: 10px; }
  .steps b { font-family: var(--head); font-size: 20px; display: block; margin-bottom: 4px; }
  .steps p { margin: 0; font-size: 15px; }
  .check { padding-left: 22px; } .check li { margin: 8px 0; }
  .reason { border-top: 4px solid var(--accent); }
  .reason h3 { font-size: 22px; }
  @media (max-width: 1000px) { .steps { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 600px) { .steps { grid-template-columns: 1fr; } }
  .about { padding-bottom: 24px; }
  .about-grid { display: grid; grid-template-columns: 1.4fr 1fr; gap: 40px; align-items: start; }
  .facts { border-top: 4px solid var(--accent); }
  .facts ul { padding-left: 18px; margin: 0 0 8px; } .facts li { margin: 6px 0; }
  .facts h4 { margin: 14px 0 6px; font-size: 17px; }
  .facts a { display: block; margin: 6px 0; font-weight: 600; text-decoration: none; }
  @media (max-width: 900px) { .about-grid { grid-template-columns: 1fr; } }
  .chips { display: flex; flex-wrap: wrap; gap: 10px; margin-bottom: 28px; }
  .chips a { border: 1px solid var(--line); border-radius: 4px; padding: 10px 16px; text-decoration: none; color: var(--navy); font-weight: 600; }
  .chips a:hover { border-color: var(--accent); }
  @media (max-width: 900px) { .wrong, .two, .compare { grid-template-columns: 1fr; } }
</style>
