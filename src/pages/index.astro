---
// Homepage, laid out as MCB + 4 Phases (see CLAUDE.md).
// Positioning: win NEW projects (new plants, expansions, new units), not just shutdown work.
import Base from '../layouts/Base.astro';
import SiteVisitForm from '../components/SiteVisitForm.astro';
import HeroSlider from '../components/HeroSlider.astro';
import DprSample from '../components/DprSample.astro';
import DelayCalculator from '../components/DelayCalculator.astro';
import PourScene from '../components/PourScene.astro';
import { company, featuredClients, stats, serviceGroups, industries, YEARS, FOUNDED } from '../data/site';

const worries = [
  { fear: '"Will my new plant start production on time?"', answer: 'One integrated plan for civil, steel, piping, mechanical and fire, made before work begins.' },
  { fear: '"Will their labour actually turn up?"', answer: 'Our own skilled team of fitters, welders and riggers, not borrowed labour.' },
  { fear: '"Will it pass testing, inspection and the fire NOC?"', answer: 'Work done to drawing and standard, with test records and documentation handed over.' },
  { fear: '"Who do I call when something goes wrong?"', answer: 'One contract and one responsible team for the whole project.' },
  { fear: '"What is actually happening on my site today?"', answer: 'A daily progress report sent to you every day of the project, so you always know where things stand.' },
  { fear: '"Will the final bill match the quote?"', answer: 'A clear scope up front, so there are no surprise extras halfway through.' },
];

const compare = [
  ['Cheapest quote on paper', 'Fair quote, with no surprise extras later'],
  ['Labour shortage halfway through the job', 'Own skilled team on every site'],
  ['Months of delay, so your plant starts earning late', 'One plan from day one, handed over on schedule'],
  ['Shortcuts on safety put your site at risk', 'Safety-first work practices and trained supervisors'],
  ['Rework after testing and inspection fail', 'Done right first time, with test records'],
  ['You chase them for updates', 'A daily progress report on your phone, every day'],
  ['4 contractors blaming each other', 'One contract, one team, one phone number'],
];
---
<Base
  title="Industrial Construction Company in Vadodara | Jay Ambe"
  description={`New plants and expansions for Gujarat's chemical, pharma and gas industries since ${FOUNDED}. Civil, steel, piping and fire fighting. Free site visit.`}
>
  <!-- ============ MCB: rotating Mass Control Bait slides (edit src/data/mcbs.ts) ============ -->
  <HeroSlider />

  <!-- ============ PHASE 1: Intro + story (the CUSTOMER is the hero) + trust ============ -->
  <section class="section" id="story">
    <div class="wrap">
      <div class="intro-grid">
      <div class="story-intro">
        <span class="eyebrow">Before you choose a contractor</span>
        <h2>Why do some new plants start on time, while others run months late?</h2>
        <p class="lead">It's rarely the budget or the drawings. In {YEARS} years of building plants in Gujarat, we've seen the difference decided <i>before the first foundation is poured.</i></p>
      </div>
      <PourScene />
      </div>

      <h3 class="wrong-h">What usually goes wrong</h3>
      <div class="wrong">
        <div><span>1</span>Work starts before the drawings and material are ready</div>
        <div><span>2</span>Civil, steel and piping go to different contractors, who wait on each other</div>
        <div><span>3</span>Labour is hired job by job, so the crew keeps changing</div>
        <div><span>4</span>Testing and fire approvals are left until the end</div>
      </div>
    </div>

    <div class="wrap">
      <div class="stats">
        {stats.map((s) => (
          <div class:list={['stat', { todo: !s.confirmed }]}>
            <b>{s.value}</b><span>{s.label}</span>
            {!s.confirmed && <em class="todo-note">real number needed</em>}
          </div>
        ))}
      </div>

      <div class="loyal">
        <b>{FOUNDED}</b>
        <p><strong>Our clients stay. Some for decades.</strong> Sicgil India has worked with us since {FOUNDED} and still does today. Gulbrandsen Chemicals worked with us for 15 years at Akalbara, and we are working at their Dahej site today.</p>
      </div>

      <div class="trusted">
        <span class="eyebrow">25+ industrial clients across Gujarat</span>
        <div class="client-list">
          {featuredClients.map((c) => <span class="client">{c}</span>)}
          <a href="/clients/" class="client more-clients">See all clients →</a>
        </div>
      </div>

      <div class="tease">
        <p>The plants that start on time avoid all four. It comes down to <b>3 decisions you make before you sign a contractor.</b></p>
        <a href="#decisions" class="btn btn-primary">See the 3 decisions ↓</a>
      </div>
    </div>
  </section>

  <!-- ============ PHASE 2a: Transformative insight, the 3 decisions (with real proof) ============ -->
  <section class="section alt" id="decisions">
    <div class="wrap">
      <div class="center">
        <span class="eyebrow">The 3 decisions</span>
        <h2>What on-time plants decide before construction starts</h2>
      </div>
      <div class="decisions">
        <ol class="dec-list">
          <li>
            <b>Lock the plan before anyone mobilises</b>
            <p>Drawings, scope, material and the testing and approval sequence are fixed up front. Work never stops to wait for "one more drawing."</p>
          </li>
          <li>
            <b>Give the whole job to one responsible contractor</b>
            <p>Civil, structural steel, piping, mechanical and fire fighting under one contract, so nobody can blame anyone else and the trades never wait on each other.</p>
          </li>
          <li>
            <b>Demand a permanent crew and proof of progress every day</b>
            <p>A contractor with their own skilled team, who shows you exactly what happened on site every evening: manpower, measured quantities and equipment. You see problems on day 1, not in month 6.</p>
            <p class="this-is"><b>This is what our clients get every evening →</b></p>
          </li>
        </ol>
        <DprSample />
      </div>
    </div>
  </section>

  <!-- ============ PHASE 2b: Transformative insight, "you're comparing the wrong number" ============ -->
  <DelayCalculator />

  <section class="section">

    <div class="wrap">
      <h3 class="center worries-h">What's really on your mind, and how we take it off</h3>
      <div class="grid g2">
        {worries.map((w) => (
          <div class="worry">
            <p class="fear">{w.fear}</p>
            <p class="answer">✔ {w.answer}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Services overview -->
  <section class="section alt">
    <div class="wrap">
      <div class="center">
        <span class="eyebrow">What we deliver</span>
        <h2>One contractor. Every trade your plant needs.</h2>
      </div>
      <div class="grid g4 svc">
        {serviceGroups.map((g) => (
          <a href="/services/" class="card svc-card">
            <span class="icon">{g.icon}</span>
            <h3>{g.name}</h3>
            <ul>{g.services.map((s) => <li>{s.name}</li>)}</ul>
            <span class="more">Explore →</span>
          </a>
        ))}
      </div>
      <p class="center industries"><b>Industries we serve:</b> {industries.join(' · ')}</p>
    </div>
  </section>

  <!-- ============ PHASE 3: The choice ============ -->
  <section class="section dark blueprint">
    <div class="wrap">
      <div class="center">
        <span class="eyebrow">The choice is yours</span>
        <h2>Two ways your next project can go.</h2>
        <p class="lead">The cheapest quote often turns into the most expensive project. Here's the difference.</p>
      </div>
      <div class="compare">
        <div class="col lose">
          <h3>❌ The lowest bidder</h3>
          <ul>{compare.map(([bad]) => <li>{bad}</li>)}</ul>
          <p class="result">Result: delays, extra cost, and questions from your management.</p>
        </div>
        <div class="col win">
          <h3>✅ Jay Ambe Engineering Works</h3>
          <ul>{compare.map(([, good]) => <li>{good}</li>)}</ul>
          <p class="result">Result: the job is done on time and you look good doing it.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ PHASE 4: Offer + CTA ============ -->
  <section class="section offer" id="site-visit">
    <div class="wrap offer-grid">
      <div>
        <span class="eyebrow">Free, no obligation</span>
        <h2>Get a FREE site visit and a FREE quote.</h2>
        <p class="lead">Planning a new plant, an expansion or a new unit? Tell us about it. Our engineer will visit your site, study your drawings and scope, and send you a clear, detailed quotation at no cost.</p>
        <ul class="offer-list">
          <li><b>Free site visit</b> by an experienced engineer</li>
          <li><b>Free detailed quote</b> with scope and timeline</li>
          <li><b>No obligation.</b> Compare us with anyone.</li>
        </ul>
        <p class="direct">Prefer to talk now?</p>
        <div class="btn-row">
          <a href={company.phoneHref} class="btn btn-outline">📞 {company.phone}</a>
          <a href={company.whatsapp} class="btn btn-primary" target="_blank" rel="noopener">💬 WhatsApp</a>
        </div>
      </div>
      <SiteVisitForm />
    </div>
  </section>
</Base>

<style>

  .intro-grid { display: grid; grid-template-columns: 1fr 1.15fr; gap: 40px; align-items: center; margin-bottom: 36px; }
  .story-intro { max-width: 620px; }
  .wrong-h { margin-bottom: 14px; }
  .wrong { display: grid; grid-template-columns: repeat(4, 1fr); gap: 14px; margin-bottom: 48px; }
  .wrong div { background: var(--tint); border-radius: var(--radius); padding: 18px; font-weight: 500; }
  .wrong span { display: grid; place-items: center; width: 30px; height: 30px; border-radius: 50%; border: 2px solid var(--navy); color: var(--navy); font-weight: 700; margin-bottom: 10px; }
  .tease { text-align: center; margin: 56px auto 0; max-width: 720px; }
  .tease p { font-size: 22px; margin-bottom: 18px; }
  .decisions { display: grid; grid-template-columns: 1.1fr 1fr; gap: 56px; align-items: center; margin-top: 40px; }
  .dec-list { list-style: none; counter-reset: d; padding: 0; margin: 0; display: grid; gap: 22px; }
  .dec-list li { counter-increment: d; position: relative; padding-left: 64px; }
  .dec-list li::before { content: counter(d); position: absolute; left: 0; top: 0; width: 46px; height: 46px; border-radius: 50%; background: var(--accent); color: var(--navy); font-family: var(--head); font-weight: 700; font-size: 24px; display: grid; place-items: center; }
  .dec-list li > b { font-family: var(--head); font-size: 24px; display: block; margin-bottom: 4px; }
  .dec-list p { margin: 0; }
  .this-is { margin-top: 10px !important; color: var(--orange); }
  .stats { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; }
  .stat { text-align: center; padding: 24px 12px; border-top: 4px solid var(--accent); background: var(--tint); }
  .stat b { display: block; font-family: var(--head); font-size: 48px; color: var(--orange); line-height: 1; }
  .stat span { display: block; color: var(--muted); font-size: 14px; margin-top: 6px; }
  .loyal { display: flex; align-items: center; gap: 24px; max-width: 860px; margin: 48px auto 0; background: var(--navy); color: #fff; border-radius: var(--radius); padding: 24px 28px; border-left: 6px solid var(--accent); }
  .loyal b { font-family: var(--head); font-size: 56px; color: var(--orange-light); line-height: 1; }
  .loyal p { margin: 0; font-size: 17px; }
  .loyal strong { display: block; font-family: var(--head); font-size: 26px; font-weight: 700; margin-bottom: 4px; }
  .more-clients { background: var(--tint); text-decoration: none; color: var(--orange) !important; }
  @media (max-width: 600px) { .loyal { flex-direction: column; align-items: flex-start; } }
  .trusted { margin-top: 40px; text-align: center; }
  .client-list { display: flex; flex-wrap: wrap; justify-content: center; gap: 12px; }
  .client { border: 1px solid var(--line); padding: 12px 22px; border-radius: 4px; font-weight: 600; color: var(--ink); }

  .worries-h { margin-bottom: 24px; }
  .worry { background: var(--tint); border-radius: var(--radius); border-left: 5px solid var(--accent); padding: 20px 24px; }
  .fear { font-family: var(--head); font-size: 22px; color: var(--ink); margin-bottom: 8px; }
  .answer { margin: 0; color: var(--muted); }

  .svc { margin-top: 36px; }
  .svc-card { text-decoration: none; color: var(--ink); border-top: 4px solid var(--accent); transition: box-shadow .15s, transform .15s; }
  .svc-card:hover { box-shadow: 0 8px 24px rgba(11,58,102,.15); transform: translateY(-3px); }
  .svc-card .icon { font-size: 32px; }
  .svc-card ul { padding-left: 18px; color: var(--muted); font-size: 15px; }
  .more { color: var(--orange); font-weight: 600; }
  .industries { margin-top: 32px; color: var(--muted); }

  .compare { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-top: 40px; }
  .col { border-radius: var(--radius); padding: 28px; }
  .col ul { list-style: none; padding: 0; margin: 0 0 16px; }
  .col li { padding: 12px 0; }
  .lose { background: rgba(255,255,255,.07); border: 1px dashed rgba(255,255,255,.35); color: var(--navy-soft); }
  .lose li { border-bottom: 1px solid rgba(255,255,255,.12); }
  .win { background: #fff; color: var(--ink); box-shadow: 0 12px 40px rgba(4,24,45,.35); }
  .win h3 { color: var(--orange) !important; }
  .win li { border-bottom: 1px solid var(--line); }
  .result { font-weight: 600; margin: 0; }

  .offer { background: linear-gradient(180deg, #fff 0%, var(--tint) 100%); }
  .offer-grid { display: grid; grid-template-columns: 1fr 1.1fr; gap: 48px; align-items: start; }
  .offer-list { padding-left: 20px; font-size: 18px; }
  .offer-list li { margin: 8px 0; }
  .direct { margin: 24px 0 10px; font-weight: 600; }

  @media (max-width: 900px) {
    .compare, .offer-grid, .decisions, .intro-grid { grid-template-columns: 1fr; }
    .wrong { grid-template-columns: 1fr 1fr; }
    .stats { grid-template-columns: repeat(2, 1fr); }
  }
</style>
