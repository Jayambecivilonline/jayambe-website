---
// Realistic live pour scene (no background box: it stands directly on the page).
// A transit mixer reverses in and feeds a truck-mounted concrete boom pump. The boom moves (2-segment
// inverse kinematics) and places concrete floor by floor: plywood formwork on steel props, rebar mesh,
// wet concrete that cures lighter, and workers guiding the hose. Then walls, lit windows and an "ON TIME" flag.
// One GSAP timeline. It pauses off-screen and shows the finished building for reduced motion.

const GROUND = 400;
const X0 = 500, W = 260, SLAB = 12, FLOOR = 70;
const BASE = GROUND - SLAB;                                              // ground slab top = 388
const tops = [0, 1, 2, 3, 4].map((k) => BASE - FLOOR * k);              // 388, 318, 248, 178, 108
const colX = [X0 + 8, X0 + W / 2 - 6, X0 + W - 20];
const propX = [X0 + 40, X0 + 80, X0 + 175, X0 + 215];
const winX = [X0 + 28, X0 + 66, X0 + 150, X0 + 188];
const D = 12, DY = 7;                                                    // depth offset for 3D top faces
---
<figure class="pour" aria-label="Animation: an RMC transit mixer and a concrete boom pump building a structure floor by floor">
  <figcaption class="cap"><span class="dot"></span> Live: RMC pour in progress · floor <b id="ps-floor">1</b> of 4</figcaption>
  <svg viewBox="0 0 800 440" aria-hidden="true">
    <defs>
      <linearGradient id="pz-ground" x1="0" x2="1"><stop offset="0" stop-color="#6b5236" stop-opacity="0" /><stop offset=".12" stop-color="#6b5236" /><stop offset=".88" stop-color="#6b5236" /><stop offset="1" stop-color="#6b5236" stop-opacity="0" /></linearGradient>
      <radialGradient id="pz-shadow"><stop offset="0" stop-color="#0B3A66" stop-opacity=".28" /><stop offset="1" stop-color="#0B3A66" stop-opacity="0" /></radialGradient>
      <linearGradient id="pz-col" x1="0" x2="1"><stop offset="0" stop-color="#eef3f8" /><stop offset=".6" stop-color="#cfdae6" /><stop offset="1" stop-color="#a9bccf" /></linearGradient>
      <linearGradient id="pz-wet" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#9fb2c6" /><stop offset="1" stop-color="#7f94aa" /></linearGradient>
      <linearGradient id="pz-dry" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#e9eff5" /><stop offset="1" stop-color="#c4d1de" /></linearGradient>
      <linearGradient id="pz-glass" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#5f8fc0" /><stop offset=".5" stop-color="#2c5d8f" /><stop offset="1" stop-color="#1b4472" /></linearGradient>
      <linearGradient id="pz-lit" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#ffd27a" /><stop offset="1" stop-color="#F5A623" /></linearGradient>
      <linearGradient id="pz-drumshade" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#fff" stop-opacity=".55" /><stop offset=".35" stop-color="#fff" stop-opacity="0" /><stop offset="1" stop-color="#0B3A66" stop-opacity=".35" /></linearGradient>
      <linearGradient id="pz-boomgrad" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#F5A623" /><stop offset="1" stop-color="#D9860F" /></linearGradient>
      <pattern id="pz-finpat" width="30" height="30" patternUnits="userSpaceOnUse" patternTransform="rotate(32)"><rect width="30" height="30" fill="#f4f7fb" /><rect width="9" height="30" fill="#EB9723" /></pattern>
      <pattern id="pz-rebarpat" width="10" height="6" patternUnits="userSpaceOnUse"><path d="M0 3H10M5 0V6" stroke="#a5582a" stroke-width="1.2" /></pattern>
      <clipPath id="pz-drumclip"><path d="M122 330 L134 274 Q196 246 262 262 L280 292 L270 330 Z" /></clipPath>
    </defs>

    <!-- ground (fades out at the sides, so there is no box) and soft shadows -->
    <rect x="0" y={GROUND} width="800" height="10" fill="url(#pz-ground)" />
    <rect x="40" y={GROUND - 2} width="720" height="3" fill="#EB9723" opacity=".35" />
    <ellipse cx={X0 + W / 2} cy={GROUND + 2} rx="170" ry="10" fill="url(#pz-shadow)" />
    <ellipse cx="380" cy={GROUND + 2} rx="110" ry="8" fill="url(#pz-shadow)" />
    <ellipse class="mixmove" cx="170" cy={GROUND + 2} rx="140" ry="8" fill="url(#pz-shadow)" />

    <!-- ================= BUILDING ================= -->
    <g id="pz-bldg">
      {[1, 2, 3, 4].map((k) => (
        <g>
          <!-- infill walls with glazing (appear at top-out) -->
          <g class="wall" data-k={k}>
            <rect x={X0} y={tops[k] + SLAB} width={W} height={FLOOR - SLAB} fill="#2a5a8a" />
            <rect x={X0} y={tops[k] + SLAB} width={W} height="6" fill="#0B3A66" opacity=".5" />
            {winX.map((x) => (
              <g>
                <rect x={x} y={tops[k] + SLAB + 14} width="32" height="34" fill="url(#pz-glass)" />
                <rect class="lit" x={x} y={tops[k] + SLAB + 14} width="32" height="34" fill="url(#pz-lit)" />
                <path d={`M${x + 16} ${tops[k] + SLAB + 14}v34M${x} ${tops[k] + SLAB + 31}h32`} stroke="#0B3A66" stroke-width="1.5" />
                <path d={`M${x + 3} ${tops[k] + SLAB + 17}l10 0l-10 12z`} fill="#fff" opacity=".18" />
              </g>
            ))}
          </g>
          <!-- steel props holding up this floor's formwork -->
          {propX.map((x) => <rect class="prop" data-k={k} x={x} y={tops[k] + SLAB} width="3" height={FLOOR - SLAB} fill="#7f9bb8" />)}
          <!-- columns rising from the slab below -->
          {colX.map((x) => (
            <g class="col" data-k={k}>
              <rect x={x} y={tops[k] + SLAB} width="12" height={FLOOR - SLAB} fill="url(#pz-col)" />
              <path d={`M${x + 12} ${tops[k] + SLAB}l5 -3v${FLOOR - SLAB}l-5 3z`} fill="#93a9bf" />
            </g>
          ))}
        </g>
      ))}

      {[0, 1, 2, 3, 4].map((k) => (
        <g>
          <!-- plywood formwork deck + rebar mesh (before the pour) -->
          <g class="deck" data-k={k}>
            <path d={`M${X0 - 4} ${tops[k]}h${W + 8}l${D} -${DY}h-${W + 8}z`} fill="#d9b47c" />
            <rect x={X0 - 4} y={tops[k]} width={W + 8} height={SLAB} fill="#c49a5e" />
            <rect class="rebar" data-k={k} x={X0 + 2} y={tops[k] - 6} width={W - 4} height="6" fill="url(#pz-rebarpat)" />
          </g>
          <!-- concrete slab (top face + front + end), poured left to right -->
          <g class="slab" data-k={k}>
            <path class="cface" d={`M${X0} ${tops[k]}h${W}l${D} -${DY}h-${W}z`} fill="url(#pz-wet)" />
            <rect class="cface" x={X0} y={tops[k]} width={W} height={SLAB} fill="url(#pz-wet)" />
            <path d={`M${X0 + W} ${tops[k]}l${D} -${DY}v${SLAB}l-${D} ${DY}z`} fill="#8ea3b8" />
          </g>
        </g>
      ))}

      <!-- roof flag -->
      <g id="pz-flag" transform={`translate(${X0 + W - 24} ${tops[4] - DY})`}>
        <line x1="0" y1="0" x2="0" y2="-54" stroke="#0B3A66" stroke-width="3" />
        <path d="M0 -54h70v26H0z" fill="#EB9723" />
        <text x="35" y="-36" text-anchor="middle" font-family="Barlow Condensed, sans-serif" font-weight="700" font-size="15" fill="#0B3A66">ON TIME ✓</text>
      </g>
    </g>

    <!-- workers on the slab: one guides the hose, one vibrates the concrete -->
    <g id="pz-crew">
      <g id="pz-w1">
        <circle cx="0" cy="-27" r="4.2" fill="#e8b88a" /><path d="M-5 -29a5 5 0 0 1 10 0z" fill="#EB9723" />
        <rect x="-4" y="-23" width="8" height="12" rx="2" fill="#0B3A66" /><rect x="-4" y="-19" width="8" height="2" fill="#F5A623" />
        <path d="M-3 -11l-2 11M3 -11l2 11" stroke="#1b2b3a" stroke-width="2.4" stroke-linecap="round" />
        <path d="M4 -20l9 -6" stroke="#0B3A66" stroke-width="2.4" stroke-linecap="round" />
      </g>
      <g id="pz-w2">
        <circle cx="0" cy="-27" r="4.2" fill="#c98f62" /><path d="M-5 -29a5 5 0 0 1 10 0z" fill="#fff" />
        <rect x="-4" y="-23" width="8" height="12" rx="2" fill="#1565C0" /><rect x="-4" y="-19" width="8" height="2" fill="#F5A623" />
        <path d="M-3 -11l-2 11M3 -11l2 11" stroke="#1b2b3a" stroke-width="2.4" stroke-linecap="round" />
        <path d="M-4 -19l-6 12" stroke="#0B3A66" stroke-width="2.4" stroke-linecap="round" /><path d="M-10 -7v8" stroke="#7f9bb8" stroke-width="2" />
      </g>
    </g>

    <!-- ================= BOOM PUMP TRUCK (cab facing the building) ================= -->
    <g id="pz-pump">
      <path d="M318 352l-22 44M452 352l22 44" stroke="#0B3A66" stroke-width="6" stroke-linecap="round" />
      <rect x="286" y="394" width="22" height="5" rx="2" fill="#0B3A66" /><rect x="466" y="394" width="22" height="5" rx="2" fill="#0B3A66" />
      <rect x="300" y="336" width="160" height="22" rx="3" fill="#0B3A66" />
      <rect x="306" y="322" width="112" height="16" rx="2" fill="#1565C0" />
      <path d="M418 358V318q0-8 8-8h26l18 26v22z" fill="#EB9723" />
      <path d="M428 318h22l12 18h-34z" fill="#cfe5fb" />
      <rect x="418" y="346" width="52" height="5" fill="#D9860F" />
      <path d="M296 330h26l-5 22h-16z" fill="#0B3A66" /><path d="M299 333h20l-2 6h-16z" fill="#7f94aa" />
      {[322, 352, 444].map((x) => <g><circle cx={x} cy="372" r="13" fill="#14243a" /><circle cx={x} cy="372" r="5" fill="#cfdae6" /></g>)}
      <rect x="384" y="306" width="22" height="18" rx="3" fill="#0B3A66" />
    </g>
    <!-- the boom is redrawn from the inverse-kinematics solution every frame -->
    <g id="pz-boom" fill="none" stroke-linecap="round" stroke-linejoin="round">
      <path id="pz-boomshadow" stroke="#0B3A66" stroke-width="13" opacity=".22" />
      <path id="pz-boomarm" stroke="url(#pz-boomgrad)" stroke-width="10" />
      <path id="pz-boomline" stroke="#0B3A66" stroke-width="2" opacity=".55" />
      <path id="pz-flowline" stroke="#d6e0ea" stroke-width="3" stroke-dasharray="4 10" />
      <circle id="pz-j0" r="7" fill="#0B3A66" /><circle id="pz-j1" r="6" fill="#0B3A66" />
      <path id="pz-hose" stroke="#1b2b3a" stroke-width="5" />
      <path id="pz-drop" stroke="#8fa6bd" stroke-width="6" />
    </g>

    <!-- ================= TRANSIT MIXER (reverses in, rear chute into the pump hopper) ================= -->
    <g id="pz-mixer" class="mixmove">
      <rect x="40" y="330" width="250" height="16" rx="3" fill="#0B3A66" />
      <path d="M40 346V292q0-10 10-10h50l18 30v34z" fill="#EB9723" />
      <path d="M54 292h40l12 22H54z" fill="#cfe5fb" /><path d="M58 296h12l-8 14h-4z" fill="#fff" opacity=".35" />
      <rect x="40" y="334" width="80" height="6" fill="#D9860F" />
      <rect x="34" y="318" width="8" height="14" rx="2" fill="#0B3A66" />
      <g clip-path="url(#pz-drumclip)">
        <rect id="pz-fins" x="60" y="230" width="300" height="120" fill="url(#pz-finpat)" />
        <rect x="100" y="240" width="200" height="100" fill="url(#pz-drumshade)" />
      </g>
      <path d="M122 330 L134 274 Q196 246 262 262 L280 292 L270 330 Z" fill="none" stroke="#0B3A66" stroke-width="2" />
      <path d="M262 262l18 30" stroke="#0B3A66" stroke-width="4" />
      <rect x="128" y="326" width="150" height="8" fill="#0B3A66" />
      <path d="M278 286 L304 330" stroke="#0B3A66" stroke-width="7" stroke-linecap="round" />
      <path id="pz-chute" d="M278 286 L304 330" stroke="#c9d6e3" stroke-width="4" stroke-linecap="round" stroke-dasharray="5 6" />
      {[80, 206, 250].map((x) => <g class="mwheel"><circle cx={x} cy="356" r="15" fill="#14243a" /><circle cx={x} cy="356" r="6" fill="#cfdae6" /><rect x={x - 1.5} y="343" width="3" height="26" fill="#5f7fa3" /></g>)}
    </g>
  </svg>
</figure>

<script>
  import { gsap } from 'gsap';

  const root = document.querySelector<HTMLElement>('.pour');
  if (root) {
    const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const $ = (s: string) => root.querySelector(s) as SVGElement;
    const $$ = (s: string) => [...root.querySelectorAll(s)] as SVGElement[];
    const GROUND = 400, X0 = 500, W = 260, SLAB = 12, FLOOR = 70, BASE = GROUND - SLAB;
    const tops = [0, 1, 2, 3, 4].map((k) => BASE - FLOOR * k);
    const HOSE = 30;

    // ---------- boom: 2-segment inverse kinematics from the turret ----------
    const S = { x: 395, y: 306 }, L1 = 240, L2 = 232;
    const REST = { x: 470, y: 300 };                     // boom parked: raised in an inverted V, tip resting toward the cab
    const st = { ...REST, flow: 0, crew: 0 };            // hose tip target, concrete flow, crew visibility
    const arm = $('#pz-boomarm'), shadow = $('#pz-boomshadow'), line = $('#pz-boomline'), flowline = $('#pz-flowline');
    const j0 = $('#pz-j0'), j1 = $('#pz-j1'), hose = $('#pz-hose'), drop = $('#pz-drop'), chute = $('#pz-chute');
    const crew = $('#pz-crew'), w1 = $('#pz-w1'), w2 = $('#pz-w2');
    const f = (n: number) => n.toFixed(1);
    function render() {
      const px = st.x, py = st.y - HOSE;
      const dx = px - S.x, dy = py - S.y;
      const d = Math.min(Math.max(Math.hypot(dx, dy), Math.abs(L1 - L2) + 2), L1 + L2 - 2);
      const a = Math.atan2(dy, dx);
      const b = Math.acos((L1 * L1 + d * d - L2 * L2) / (2 * L1 * d));
      const t1 = a - b;                                   // elbow up
      const ex = S.x + L1 * Math.cos(t1), ey = S.y + L1 * Math.sin(t1);
      const a2 = Math.atan2(py - ey, px - ex);
      const tx = ex + L2 * Math.cos(a2), ty = ey + L2 * Math.sin(a2);
      const path = `M${S.x} ${S.y}L${f(ex)} ${f(ey)}L${f(tx)} ${f(ty)}`;
      arm.setAttribute('d', path); line.setAttribute('d', path); flowline.setAttribute('d', path);
      shadow.setAttribute('d', `M${S.x + 4} ${S.y + 6}L${f(ex + 4)} ${f(ey + 6)}L${f(tx + 4)} ${f(ty + 6)}`);
      j0.setAttribute('cx', String(S.x)); j0.setAttribute('cy', String(S.y));
      j1.setAttribute('cx', f(ex)); j1.setAttribute('cy', f(ey));
      hose.setAttribute('d', `M${f(tx)} ${f(ty)}q4 ${HOSE / 2} 0 ${HOSE - 6}`);
      drop.setAttribute('d', `M${f(tx)} ${f(ty + HOSE - 6)}V${st.y - 3}`);
      drop.setAttribute('opacity', String(st.flow));
      flowline.setAttribute('opacity', String(st.flow * 0.9));
      chute.setAttribute('opacity', String(st.flow));
      crew.setAttribute('opacity', String(st.crew));
      w1.setAttribute('transform', `translate(${f(tx - 14)} ${st.y - 7})`);
      w2.setAttribute('transform', `translate(${f(tx + 34)} ${st.y - 7})`);
    }

    const k$ = (sel: string, k: number) => $$(`${sel}[data-k="${k}"]`);
    const setFloor = (n: number) => { const el = root.querySelector('#ps-floor'); if (el) el.textContent = String(n); };

    const tl = gsap.timeline({ repeat: -1, defaults: { ease: 'power2.inOut' }, onUpdate: render });
    // reset to bare ground
    tl.set($$('.slab'), { scaleX: 0, transformOrigin: '0% 50%' })
      .set($$('.cface'), { attr: { fill: 'url(#pz-wet)' } })
      .set($$('.deck'), { opacity: 0 })
      .set($$('.rebar'), { opacity: 0 })
      .set($$('.prop'), { scaleY: 0, opacity: 1, transformOrigin: '50% 100%' })
      .set($$('.col'), { scaleY: 0, transformOrigin: '50% 100%' })
      .set($$('.wall'), { opacity: 0 })
      .set($$('.lit'), { opacity: 0 })
      .set('#pz-flag', { scaleY: 0, transformOrigin: '0% 100%' })
      .set('#pz-bldg', { opacity: 1 })
      .set($$('.mixmove'), { x: -340 })
      .set(st, { ...REST, flow: 0, crew: 0 })
      .call(() => setFloor(1));

    // the mixer reverses in to the pump hopper
    tl.to($$('.mixmove'), { x: 0, duration: 2.2, ease: 'power2.out' }, 'in')
      .to($$('.mwheel'), { rotation: 720, transformOrigin: '50% 50%', duration: 2.2, ease: 'power2.out' }, 'in');

    // each level: columns + props → formwork deck → rebar → boom to the start → pour sweep → cure
    [0, 1, 2, 3, 4].forEach((k) => {
      const y = tops[k];
      tl.add(`L${k}`);
      if (k > 0) {
        tl.to(k$('.col', k), { scaleY: 1, duration: 0.7, stagger: 0.12, ease: 'power3.out' }, `L${k}`)
          .to(k$('.prop', k), { scaleY: 1, duration: 0.4, stagger: 0.06 }, '<0.3');
      }
      tl.to(k$('.deck', k), { opacity: 1, duration: 0.35 })
        .to(k$('.rebar', k), { opacity: 1, duration: 0.35 })
        .call(() => setFloor(Math.max(1, k)))
        .to(st, { x: X0 + 14, y, duration: 0.9 }, '<')
        .to(st, { crew: 1, flow: 1, duration: 0.15 })
        .to(k$('.slab', k), { scaleX: 1, duration: 1.7, ease: 'none' }, '<')
        .to(st, { x: X0 + W - 6, duration: 1.7, ease: 'none' }, '<')
        .to(st, { crew: 0, flow: 0, duration: 0.15 })
        .set(root.querySelectorAll(`.slab[data-k="${k}"] .cface`), { attr: { fill: 'url(#pz-dry)' } }, '+=0.4')
        .to(k$('.deck', k), { opacity: 0, duration: 0.3 }, '<');
      if (k > 1) tl.to(k$('.prop', k - 1), { opacity: 0, duration: 0.3 }, '<');   // strip props once the slab above is cast
    });

    // top-out: boom folds back, props cleared, walls and glazing, lights on, flag up
    tl.to(st, { ...REST, duration: 1.1 })
      .to(k$('.prop', 4), { opacity: 0, duration: 0.3 }, '<')
      .to($$('.wall'), { opacity: 1, duration: 0.5, stagger: 0.15 }, '<0.2')
      .to($$('.lit'), { opacity: 1, duration: 0.25, stagger: 0.04 })
      .to('#pz-flag', { scaleY: 1, duration: 0.5, ease: 'back.out(2)' })
      .call(() => setFloor(4))
      .to($$('.mixmove'), { x: -340, duration: 2, ease: 'power2.in' }, '+=0.5')
      .to($$('.mwheel'), { rotation: '-=720', transformOrigin: '50% 50%', duration: 2, ease: 'power2.in' }, '<')
      .to('#pz-bldg', { opacity: 0, duration: 0.8 }, '+=1.8');

    // the drum turns continuously
    const fins = gsap.to('#pz-fins', { x: -30 / Math.cos((32 * Math.PI) / 180), duration: 0.85, ease: 'none', repeat: -1 });

    // dev-only hook so the sequence can be stepped through in tests (removed from production builds)
    if (import.meta.env.DEV) (window as unknown as { __pour: typeof tl }).__pour = tl;

    render();
    if (still) {
      tl.progress(0.92).pause();
      fins.pause();
      render();
    } else {
      new IntersectionObserver(([e]) => { if (e.isIntersecting) { tl.play(); fins.play(); } else { tl.pause(); fins.pause(); } }, { threshold: 0.15 }).observe(root);
    }
  }
</script>

<style>
  .pour { margin: 0; position: relative; }
  .pour svg { display: block; width: 100%; height: auto; overflow: visible; }
  .cap { display: inline-flex; align-items: center; gap: 8px; font-size: 13px; font-weight: 600; color: var(--navy); background: var(--tint); border: 1px solid var(--line); border-radius: 999px; padding: 6px 14px; margin-bottom: 6px; }
  .cap b { color: var(--orange); }
  .dot { width: 8px; height: 8px; border-radius: 50%; background: var(--accent); animation: live 1.6s infinite; }
  @keyframes live { 0% { box-shadow: 0 0 0 0 rgba(235,151,35,.6); } 70%, 100% { box-shadow: 0 0 0 8px rgba(235,151,35,0); } }
  @media (prefers-reduced-motion: reduce) { .dot { animation: none; } }
</style>
