---
import '../styles/global.css';
import { company, serviceGroups, FOUNDED } from '../data/site';
import { industryPages } from '../data/seoPages';

interface Props {
  title: string;
  description: string;
  /** extra schema.org objects for this page (FAQPage, Service, BreadcrumbList…) */
  schema?: object[];
  /** keep test pages out of Google */
  noindex?: boolean;
}
const { title, description, schema = [], noindex = false } = Astro.props;
const path = Astro.url.pathname;

const nav = [
  { href: '/', label: 'Home' },
  { href: '/about/', label: 'About' },
  { href: '/services/', label: 'Services' },
  { href: '/industries/', label: 'Industries' },
  { href: '/clients/', label: 'Clients' },
  { href: '/guides/', label: 'Guides' },
  { href: '/contact/', label: 'Contact' },
];
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  {noindex && <meta name="robots" content="noindex, nofollow" />}
  <link rel="canonical" href={new URL(path, Astro.site)} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <link rel="icon" type="image/png" href="/favicon.png" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <meta property="og:image" content={new URL("/logo.png", Astro.site)} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@600;700&family=Inter:wght@400;500;600;800&display=swap" rel="stylesheet" />
  <!-- site-wide business entity: one @id so every page's schema refers to the same company -->
  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'GeneralContractor',
    '@id': `${Astro.site}#business`,
    name: company.name,
    alternateName: 'Jay Ambe Engineering',
    url: Astro.site,
    logo: new URL('/logo.png', Astro.site).href,
    image: new URL('/logo.png', Astro.site).href,
    description: `Industrial construction and EPC contractor in Nandesari, Vadodara since ${FOUNDED}: factories, industrial sheds, PEB structures, warehouses, civil works, structural steel, process piping, fire fighting systems and precast compound walls.`,
    foundingDate: String(FOUNDED),
    founder: { '@type': 'Person', '@id': `${Astro.site}about/vipulbhai-padhiyar/#person`, name: company.founder, url: new URL('/about/vipulbhai-padhiyar/', Astro.site).href },
    telephone: company.phone,
    email: company.email,
    address: { '@type': 'PostalAddress', streetAddress: 'A/27 Nilkhant Society, Nandesari', addressLocality: 'Vadodara', addressRegion: 'Gujarat', addressCountry: 'IN' },
    areaServed: ['Vadodara', 'Nandesari GIDC', 'Makarpura GIDC', 'Manjusar GIDC', 'Savli', 'Halol', 'Waghodia', 'Padra', 'Karjan', 'Por', 'Dahej', 'Bharuch', 'Gujarat'].map((name) => ({ '@type': 'Place', name })),
    knowsAbout: ['Industrial construction', 'EPC contracting', 'Pre-engineered buildings', 'Industrial sheds', 'Warehouse construction', 'Structural steel fabrication', 'Process piping', 'Fire fighting systems', 'Precast compound walls', 'Plant maintenance', 'Shutdown and turnaround'],
    hasOfferCatalog: {
      '@type': 'OfferCatalog',
      name: 'Industrial construction services',
      itemListElement: serviceGroups.flatMap((g) => g.services).map((s) => ({ '@type': 'Offer', itemOffered: { '@type': 'Service', name: s.name, url: new URL(`/services/${s.slug}/`, Astro.site).href } })),
    },
    sameAs: [company.googleProfile, company.googleKg, company.indiamart],
  })} />
  {schema.map((s) => <script type="application/ld+json" set:html={JSON.stringify({ "@context": "https://schema.org", ...s })} />)}
</head>
<body>
  <header class="site-header">
    <div class="wrap bar">
      <a href="/" class="logo" aria-label={company.name}>
        <img src="/emblem.png" alt="" width="52" height="52" />
        <span class="words"><b>Jay Ambe</b><small>Engineering Works · Since {FOUNDED}</small></span>
      </a>
      <button class="menu-btn" aria-label="Open menu" aria-expanded="false">☰</button>
      <nav class="nav">
        {nav.map((n) => n.href === '/services/' ? (
          <div class="has-mega">
            <a href={n.href} class:list={['mega-top', { active: path.startsWith(n.href) }]} aria-haspopup="true">{n.label} <span class="caret" aria-hidden="true">▾</span></a>
            <button class="sub-toggle" type="button" aria-expanded="false" aria-label="Show all services">▾</button>
            <!-- mega menu: slides down on hover / keyboard focus (desktop), expands on tap (mobile) -->
            <div class="mega">
              <div class="wrap mega-cols">
                {serviceGroups.map((g) => (
                  <div class="mcol">
                    <p class="mhead">{g.name}</p>
                    {g.services.map((s) => <a href={`/services/${s.slug}/`}>{s.name}</a>)}
                  </div>
                ))}
              </div>
              <div class="mega-foot">
                <div class="wrap mega-foot-in">
                  <span><b>Industries:</b> {industryPages.map((i) => <a href={`/industries/${i.slug}/`}>{i.name}</a>)}</span>
                  <a href="/contact/#site-visit" class="btn btn-primary">Book Free Site Visit</a>
                </div>
              </div>
            </div>
          </div>
        ) : (
          <a href={n.href} class:list={[{ active: n.href === '/' ? path === '/' : path.startsWith(n.href) }]}>{n.label}</a>
        ))}
        <a href="/contact/#site-visit" class="btn btn-primary nav-cta">Book Free Site Visit</a>
      </nav>
    </div>
  </header>

  <main><slot /></main>

  <footer class="site-footer">
    <div class="wrap grid g4">
      <div>
        <div class="logo"><img src="/emblem.png" alt="" width="52" height="52" /><span class="words"><b>Jay Ambe</b><small>Engineering Works</small></span></div>
        <p class="f-muted">Industrial construction, piping, structural and fire fighting contractor for Gujarat's process industries since {FOUNDED}.</p>
      </div>
      <div>
        <h4>Services</h4>
        {serviceGroups.flatMap((g) => g.services).slice(0, 8).map((s) => <a href={`/services/${s.slug}/`}>{s.name}</a>)}
        <a href="/services/">All services →</a>
      </div>
      <div>
        <h4>Company</h4>
        <a href="/about/">About Us</a>
        <a href="/clients/">Clients &amp; Track Record</a>
        <a href="/industries/">Industries</a>
        <a href="/guides/">Guides</a>
        <a href="/safety-quality/">Safety &amp; Quality</a>
        <a href="/daily-progress-report/">Daily Progress Report</a>
        <a href="/faq/">FAQ</a>
        <a href="/careers/">Careers</a>
        <a href="/contact/">Contact</a>
        <h4 class="f-sub">Areas we serve</h4>
        <a href="/locations/vadodara/">Vadodara</a>
        <a href="/locations/nandesari/">Nandesari GIDC</a>
        <a href="/locations/padra/">Padra &amp; Umraya</a>
        <a href="/locations/makarpura/">Makarpura GIDC</a>
        <a href="/locations/manjusar/">Manjusar GIDC</a>
        <a href="/locations/savli/">Savli</a>
        <a href="/locations/halol/">Halol</a>
        <a href="/locations/waghodia/">Waghodia</a>
        <a href="/locations/dahej/">Dahej</a>
      </div>
      <div>
        <h4>Contact</h4>
        <p class="f-muted">{company.address}</p>
        <a href={company.phoneHref}>📞 {company.phone}</a>
        <a href={`mailto:${company.email}`}>✉ {company.email}</a>
        <a href={company.googleProfile} target="_blank" rel="noopener">⭐ Google Business Profile</a>
      </div>
    </div>
    <div class="wrap copy">© {new Date().getFullYear()} {company.name}. All rights reserved.</div>
  </footer>

  <div class="mobile-bar">
    <a href={company.phoneHref}>📞 Call</a>
    <a href={company.whatsapp} target="_blank" rel="noopener">💬 WhatsApp</a>
    <a href="/contact/#site-visit" class="hl">Free Site Visit</a>
  </div>

  <script>
    import '../scripts/reveal';
    const btn = document.querySelector('.menu-btn');
    const nav = document.querySelector('.nav');
    btn?.addEventListener('click', () => {
      const open = nav?.classList.toggle('open');
      btn.setAttribute('aria-expanded', String(!!open));
    });
    // mobile: tap the arrow to expand the services list
    document.querySelectorAll<HTMLButtonElement>('.sub-toggle').forEach((t) => t.addEventListener('click', () => {
      const open = t.parentElement!.classList.toggle('open');
      t.setAttribute('aria-expanded', String(open));
    }));
    // desktop: Escape closes the mega menu
    addEventListener('keydown', (e) => { if (e.key === 'Escape') (document.activeElement as HTMLElement | null)?.blur(); });
  </script>
</body>
</html>

<style>
  .site-header { position: sticky; top: 0; z-index: 50; background: #fff; border-bottom: 4px solid var(--accent); box-shadow: 0 2px 12px rgba(11,58,102,.08); }
  .bar { display: flex; align-items: center; justify-content: space-between; gap: 16px; min-height: 76px; }
  .logo { display: flex; align-items: center; gap: 10px; text-decoration: none; }
  .logo img { width: 52px; height: 52px; }
  .words { display: flex; flex-direction: column; line-height: 1.1; }
  .words b { font-family: var(--body); font-weight: 800; font-size: 24px; color: #EB9723; letter-spacing: -.3px; }
  .words small { font-size: 12px; color: var(--ink); letter-spacing: .3px; }
  .nav { display: flex; align-items: center; gap: 22px; }
  .nav a:not(.btn) { color: var(--ink); text-decoration: none; font-weight: 500; font-size: 15px; }
  .nav a:not(.btn):hover, .nav a.active { color: var(--orange); }
  .nav-cta { padding: 10px 18px; font-size: 15px; }
  /* ----- services mega menu (desktop: slides down on hover / focus) ----- */
  .has-mega { align-self: stretch; display: flex; align-items: center; }
  .mega-top .caret { font-size: 11px; display: inline-block; transition: transform .2s; }
  .has-mega:hover .caret, .has-mega:focus-within .caret { transform: rotate(180deg); }
  .sub-toggle { display: none; }
  .mega { position: absolute; left: 0; right: 0; top: 100%; background: #fff; box-shadow: 0 24px 48px rgba(11,58,102,.18); border-top: 1px solid var(--line);
          opacity: 0; visibility: hidden; transform: translateY(-14px); transition: opacity .22s ease, transform .28s cubic-bezier(.2,.8,.2,1), visibility 0s linear .28s; pointer-events: none; }
  .mega::before { content: ''; position: absolute; left: 0; right: 0; top: -12px; height: 12px; } /* bridge so the menu doesn't close on the way down */
  .has-mega:hover .mega, .has-mega:focus-within .mega { opacity: 1; visibility: visible; transform: none; transition: opacity .22s ease, transform .28s cubic-bezier(.2,.8,.2,1), visibility 0s; pointer-events: auto; }
  .mega-cols { display: grid; grid-template-columns: repeat(4, 1fr); padding-top: 0; padding-bottom: 0; }
  .mcol { padding: 24px 22px 22px; }
  .mcol:nth-child(even) { background: var(--tint); }
  .mhead { font-family: var(--head); font-size: 20px; font-weight: 700; color: var(--navy); letter-spacing: .5px; text-transform: uppercase; margin: 0 0 10px; padding-bottom: 8px; border-bottom: 2px solid var(--accent); }
  .nav .mcol a { display: block; padding: 8px 0; border-bottom: 1px solid var(--line); color: var(--ink); font-size: 15px; transition: color .15s, padding-left .15s; }
  .nav .mcol a:hover { color: var(--orange); padding-left: 6px; }
  .mega-foot { background: var(--navy); }
  .mega-foot-in { display: flex; align-items: center; justify-content: space-between; gap: 16px; padding-top: 12px; padding-bottom: 12px; color: #fff; font-size: 14px; }
  .mega-foot-in b { color: var(--orange-light); }
  .nav .mega-foot-in span a { color: #fff; margin-left: 12px; font-size: 14px; }
  .nav .mega-foot-in span a:hover { color: var(--orange-light); }
  .mega-foot .btn { padding: 8px 16px; font-size: 14px; }
  .menu-btn { display: none; background: none; border: 0; color: var(--navy); font-size: 28px; cursor: pointer; }

  .site-footer { background: var(--navy); color: #fff; padding: 56px 0 24px; }
  .site-footer .logo { background: #fff; padding: 8px 14px 8px 8px; border-radius: var(--radius); display: inline-flex; }
  .site-footer .f-sub { margin-top: 20px; }
  .site-footer h4 { font-size: 18px; color: var(--orange-light); margin-bottom: 12px; }
  .site-footer a { display: block; color: var(--navy-soft); text-decoration: none; margin: 6px 0; font-size: 15px; }
  .site-footer a:hover { color: var(--orange-light); }
  .f-muted { color: var(--navy-soft); font-size: 15px; margin-top: 12px; }
  .copy { border-top: 1px solid rgba(255,255,255,.18); margin-top: 32px; padding-top: 18px; font-size: 13px; color: var(--navy-soft); }

  .mobile-bar { display: none; }

  @media (max-width: 1080px) {
    .menu-btn { display: block; }
    .nav { display: none; position: absolute; top: 80px; left: 0; right: 0; background: #fff; flex-direction: column; align-items: stretch; padding: 12px 16px 20px; gap: 4px; border-bottom: 4px solid var(--accent); box-shadow: 0 10px 20px rgba(11,58,102,.12); }
    .nav.open { display: flex; max-height: calc(100vh - 84px); overflow-y: auto; overscroll-behavior: contain; } /* long menus scroll inside */
    .nav a:not(.btn) { padding: 12px 4px; border-bottom: 1px solid var(--line); }
    .nav-cta { justify-content: center; margin-top: 10px; }
    /* mega menu on phones: tap the arrow to expand */
    .has-mega { flex-wrap: wrap; align-self: auto; }
    .has-mega .mega-top { flex: 1; }
    .mega-top .caret { display: none; }
    .sub-toggle { display: block; background: none; border: 0; font-size: 18px; color: var(--navy); padding: 8px 14px; cursor: pointer; border-bottom: 1px solid var(--line); }
    .has-mega.open .sub-toggle { transform: rotate(180deg); }
    .mega { position: static; flex-basis: 100%; display: none; opacity: 1; visibility: visible; transform: none; box-shadow: none; border: 0; pointer-events: auto; transition: none; }
    .has-mega.open .mega { display: block; }
    .mega-cols { grid-template-columns: 1fr; padding: 0; }
    .mcol { padding: 10px 6px; background: none !important; }
    .mhead { font-size: 16px; margin-bottom: 4px; }
    .nav .mcol a { padding: 9px 4px 9px 12px; font-size: 15px; }
    .mega-foot { display: none; }
  }
  @media (max-width: 700px) {
    .nav.open { max-height: calc(100vh - 84px - 64px); } /* stop above the Call/WhatsApp bar */
    .mobile-bar { display: grid; grid-template-columns: 1fr 1fr 1.3fr; position: fixed; bottom: 0; left: 0; right: 0; z-index: 60; background: var(--navy); border-top: 3px solid var(--accent); }
    .mobile-bar a { color: #fff; text-decoration: none; text-align: center; padding: 16px 4px; font-weight: 600; font-size: 15px; }
    .mobile-bar a.hl { background: var(--accent); color: var(--navy); }
  }
</style>
